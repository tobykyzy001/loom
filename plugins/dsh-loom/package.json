{
  "name": "@loom/dsh-loom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Explicitly configured Loom outbound node scaffold for DSH; real execution uses verified public Agent APIs only and defaults off.",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "lib", "src", "locale/*.json", "README.md", "icon.svg"],
  "engines": { "node": ">=22.0.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "scripts": { "test": "node --test test/*.test.js" }
}
